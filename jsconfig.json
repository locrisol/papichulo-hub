{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "checkJs": false
  },
  "include": ["src/**/*", "tests/**/*", "vite.config.js"],
  "exclude": ["node_modules", "dist"]
}
