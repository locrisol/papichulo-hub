# Copy this file to .env and fill in the values.
# .env holds real keys, is ignored by git, and must stay that way.

# From your Supabase project, under Project Settings then API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed in production. The base address used to build the public allergen
# link that goes into the QR code. Leave it empty locally and the app uses
# whatever address you are running on.
VITE_PUBLIC_URL=

# Neither of the two keys below is here, and neither must ever be put here.
#
# Anything prefixed VITE_ is written into the built site, so a key in one is a
# key anybody can read out of the bundle and spend. The Ticketmaster one lived
# here until 20 September 2026 and the quota was open to whoever looked.
#
# Both are secrets on the functions that use them:
#
#   npx supabase secrets set TICKETMASTER_KEY=...
#   npx supabase secrets set GEMINI_KEY=...
#
# TICKETMASTER_KEY is a Consumer Key from developer.ticketmaster.com, used by
# nearby-events. It is an account key and not tied to any venue: 5,000 calls a
# day and five a second, shared across the whole Hub.
#
# GEMINI_KEY is a Google AI Studio key, used by read-listings to turn a public
# listings page into rows. Free, no card, and a Workspace account can make one
# in a couple of clicks. Gemini in Gmail and Docs is the assistant rather than
# API access, which are different things and only one of them is this.
#
# **Nothing from the database is ever sent to it.** On the free tier Google may
# use what is sent to improve their products, so what leaves the Hub is the text
# of a page that was already public and not one word about us.
#
# Only needed to run the database tests with npm run test:rls. These are real
# accounts on your Supabase project, one per role, all at the same restaurant.
# Do not prefix them with VITE_, or they would end up in the built site.
TEST_EMPLOYEE_EMAIL=
TEST_EMPLOYEE_PASSWORD=
TEST_MANAGER_EMAIL=
TEST_MANAGER_PASSWORD=
TEST_OWNER_EMAIL=
TEST_OWNER_PASSWORD=
TEST_SUPERADMIN_EMAIL=
TEST_SUPERADMIN_PASSWORD=
