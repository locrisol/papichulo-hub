# Copy this file to .env and fill in the values.
# .env holds real keys, is ignored by git, and must stay that way.

# From your Supabase project, under Project Settings then API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed in production. The base address used to build the public allergen
# link that goes into the QR code. Leave it empty locally and the app uses
# whatever address you are running on.
VITE_PUBLIC_URL=

# Ticketmaster Discovery API, for pulling 3Arena events. Get a Consumer Key at
# developer.ticketmaster.com. Only reads public data.
VITE_TICKETMASTER_KEY=

# Only needed to run the database tests with npm run test:rls. These are real
# accounts on your Supabase project, one per role, all at the same restaurant.
# Do not prefix them with VITE_, or they would end up in the built site.
TEST_EMPLOYEE_EMAIL=
TEST_EMPLOYEE_PASSWORD=
TEST_MANAGER_EMAIL=
TEST_MANAGER_PASSWORD=
TEST_OWNER_EMAIL=
TEST_OWNER_PASSWORD=
TEST_SUPERADMIN_EMAIL=
TEST_SUPERADMIN_PASSWORD=
